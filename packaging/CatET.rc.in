// CatET.rc.in —— Windows 资源脚本模板（由 CMake configure_file 生成 CatET.rc）
//
// 生成物（构建目录下的 generated/CatET.rc）由 CMakeLists.txt 通过 target_sources
// 交给 windres 编译，提供：
//   1) 应用程序图标（显示在资源管理器 / 任务栏 / 快捷方式）
//   2) 版本信息（右键 exe → 属性 → 详细信息）
//
// 版本号与组织名由 CMake 变量注入（@CATET_VERSION@、@CATET_VENDOR@），
// 因此 CI 打 tag 发版时 exe 属性页显示的版本与安装包文件名一致，无需手改。

#include <windows.h>

// 主图标：ID 1，引用打包目录下的 CatET.ico。
// 本文件生成在构建目录，故使用 CMake 注入的绝对路径（正斜杠，windres 可识别）。
IDI_ICON1 ICON "@CATET_RC_ICON@"

// ─── 版本信息（右键 exe → 属性 → 详细信息）───────────────────────────────
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @CATET_VERSION_COMMA@
 PRODUCTVERSION  @CATET_VERSION_COMMA@
 FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
 FILEFLAGS       0x1L
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@CATET_VENDOR@"
            VALUE "FileDescription",  "CatET - Cat's English Trial"
            VALUE "FileVersion",      "@CATET_VERSION@"
            VALUE "InternalName",     "CatET"
            VALUE "LegalCopyright",   "Copyright (C) 2026 @CATET_VENDOR@"
            VALUE "OriginalFilename", "CatET.exe"
            VALUE "ProductName",      "CatET"
            VALUE "ProductVersion",   "@CATET_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
