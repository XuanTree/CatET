{
  "version": 8,
  "configurePresets": [
    {
      "name": "gcc-mingw",
      "displayName": "GCC 16.1.0 (Debug)",
      "description": "正在使用编译器: C = C:\\msys64\\mingw64\\bin\\gcc.exe, CXX = C:\\msys64\\mingw64\\bin\\g++.exe",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "PATH": "C:/msys64/mingw64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/mingw64/bin/mingw32-make.exe",
        "Python3_EXECUTABLE": "C:/msys64/mingw64/bin/python.exe",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-mingw-release",
      "displayName": "GCC 16.1.0 (Release)",
      "description": "Release 构建，用于 CPack 打包发布",
      "inherits": "gcc-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "构建 Debug",
      "configurePreset": "gcc-mingw"
    },
    {
      "name": "release",
      "displayName": "构建 Release",
      "configurePreset": "gcc-mingw-release"
    }
  ],
  "packagePresets": [
    {
      "name": "nsis",
      "displayName": "打包 Windows 安装程序 (NSIS)",
      "description": "生成 CET-<版本>-Windows.exe 安装向导",
      "configurePreset": "gcc-mingw-release",
      "generators": [
        "NSIS"
      ]
    }
  ]
}